# Copia a apps/web/.env.staging
# Uso: pnpm --filter web run dev:staging  (o `pnpm dev:staging` desde la raíz con Turbo)
# El script pone APP_ENV=staging; next.config.js carga este archivo (con override sobre .env.development).
#
# Si además tienes apps/web/.env.local, Next lo mezcla en dev: puede pisar claves repetidas
# (p. ej. DATABASE_URL). Quita o comenta duplicados en .env.local mientras pruebas staging.

NEXT_PUBLIC_API_URL=https://tu-api-staging.ejemplo.com

# Solo si el front necesita Prisma/DB en local contra staging:
# DATABASE_URL="postgresql://..."
