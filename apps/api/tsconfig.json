{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "target": "ES2023",

    "declaration": true,
    "sourceMap": true,
    "outDir": "./dist",

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    "strict": true,

    "incremental": true,
    "skipLibCheck": true,

    "baseUrl": "./"
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
