enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CREDIT
}

model Sale {
  id String @id @default(cuid())

  branchId      String
  customerId    String?
  cashierId     String
  cashShiftId   String?
  ncfSequenceId String?
  reservationId String?

  ncf       String?
  ncfType   NcfType?
  subtotal  Decimal    @db.Decimal(10, 2)
  taxAmount Decimal    @default(0) @db.Decimal(10, 2)
  total     Decimal    @db.Decimal(10, 2)
  status    SaleStatus @default(PENDING)

  branch      Branch       @relation(fields: [branchId], references: [id])
  customer    Customer?    @relation(fields: [customerId], references: [id])
  cashier     Employee     @relation(fields: [cashierId], references: [id])
  cashShift   CashShift?   @relation(fields: [cashShiftId], references: [id])
  ncfSequence NcfSequence? @relation(fields: [ncfSequenceId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])

  items               SaleItem[]
  payments            Payment[]
  inventoryMovements  InventoryMovement[]
  accountReceivable   AccountReceivable?
  returns             Return[]
  redeemedCreditNotes CreditNote[]        @relation("CreditNoteRedemption")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([customerId])
  @@index([cashierId])
  @@index([reservationId])
  @@index([status])
  @@index([ncfType])
  @@index([createdAt])
}

model SaleItem {
  id String @id @default(cuid())

  saleId    String
  productId String

  quantity           Decimal  @db.Decimal(12, 3)
  unitPrice          Decimal  @db.Decimal(10, 2)
  discountPercentage Decimal? @db.Decimal(5, 2)
  discountAmount     Decimal? @db.Decimal(10, 2)
  subtotal           Decimal  @db.Decimal(10, 2)

  taxRate   Decimal @default(0) @db.Decimal(5, 2)
  taxAmount Decimal @default(0) @db.Decimal(10, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id String @id @default(cuid())

  saleId String
  method PaymentMethod
  amount Decimal       @db.Decimal(10, 2)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([saleId])
}
