// This is your Prisma schema file,

// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"

  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  OWNER

  ADMIN

  MANAGER

  CASHIER

  INVENTORY_ASSISTANT
}

/// Master data con soft delete. Al agregar Product, Customer, Supplier, Employee, etc., incluir

/// `deletedAt`, `@@unique([campo, deletedAt])` en campos únicos y registrar el

/// modelo en `packages/database/src/soft-delete/config.ts`.

model Company {
  id   String  @id @default(cuid())
  name String
  slug String
  rnc  String?

  email String?

  phone String?

  isActive Boolean @default(true)

  deletedAt DateTime?

  branches Branch[]

  users UserCompany[]

  categories Category[]

  products Product[]

  employees Employee[]

  suppliers Supplier[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([slug, deletedAt])
}

model Branch {
  id String @id @default(cuid())

  companyId String

  name String

  address String?

  isActive Boolean @default(true)

  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id])

  employees Employee[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([deletedAt])
}

model User {
  id String @id @default(cuid())

  email String

  passwordHash String

  firstName String

  lastName String

  isActive Boolean @default(true)

  deletedAt DateTime?

  lastLoginAt DateTime?

  memberships UserCompany[]

  employee Employee?

  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([email, deletedAt])
}

model Role {
  id String @id @default(cuid())

  name RoleName

  description String?

  deletedAt DateTime?

  users UserCompany[]

  @@unique([name, deletedAt])
}

model UserCompany {
  id String @id @default(cuid())

  userId String

  companyId String

  roleId String

  defaultBranchId String?

  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  company Company @relation(fields: [companyId], references: [id])

  role Role @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([userId, deletedAt])
  @@index([companyId])
  @@index([deletedAt])
}

model RefreshToken {
  id String @id @default(cuid())

  userId String

  hashedToken String

  expiresAt DateTime

  revoked Boolean @default(false)

  revokedAt DateTime?

  createdByIp String?

  revokedByIp String?

  userAgent String?

  replacedByTokenId String?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id String @id @default(cuid())

  companyId String?

  userId String?

  action String

  entity String?

  entityId String?

  metadata Json?

  createdAt DateTime @default(now())
}

model Category {
  id String @id @default(cuid())

  companyId String

  name String

  description String?

  isActive Boolean @default(true)

  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id])

  products Product[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([companyId, name, deletedAt])
  @@index([companyId])
  @@index([deletedAt])
}

model Product {
  id String @id @default(cuid())

  companyId String

  supplierId String?

  name String

  code String

  description String?

  imageUrl String?

  price Decimal @db.Decimal(10, 2)

  isActive Boolean @default(true)

  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id])

  supplier Supplier? @relation(fields: [supplierId], references: [id])

  categories Category[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([companyId, code, deletedAt])
  @@index([companyId])
  @@index([deletedAt])
}

/// Usuario operativo del ERP. Siempre vinculado a User + UserCompany.

model Employee {
  id String @id @default(cuid())

  companyId String

  branchId String

  userId String @unique

  phone String?

  position String?

  salary Decimal? @db.Decimal(10, 2)

  hireDate DateTime?

  terminationDate DateTime?

  isActive Boolean @default(true)

  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id])

  branch Branch @relation(fields: [branchId], references: [id])

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([branchId])
  @@index([deletedAt])
}

model Supplier {
  id String @id @default(cuid())

  companyId String

  name String

  contactName String?

  email String?

  phone String?

  rnc String?

  address String?

  notes String?

  isActive Boolean @default(true)

  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id])

  products Product[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([companyId, name, deletedAt])
  @@index([companyId])
  @@index([deletedAt])
}
