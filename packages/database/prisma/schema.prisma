// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"

  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  OWNER
  ADMIN
  MANAGER
  CASHIER
  INVENTORY_ASSISTANT
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CREDIT
}

enum ReceivableStatus {
  OPEN
  PARTIAL
  PAID
  OVERDUE
}

enum PayableStatus {
  OPEN
  PARTIAL
  PAID
  OVERDUE
}

enum InventoryMovementType {
  PURCHASE
  SALE
  RETURN
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  WASTE
}

enum NcfType {
  CONSUMIDOR_FINAL
  CREDITO_FISCAL
  GUBERNAMENTAL
  REGIMEN_ESPECIAL
  EXPORTACION
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  RECEIVED
  CANCELLED
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum ReturnReason {
  DEFECTIVE
  SALES_ERROR
  EXPIRED
  OTHER
}

/// Master data con soft delete. Al agregar Product, Customer, Supplier, Employee, etc., incluir
/// `deletedAt`, `@@unique([campo, deletedAt])` en campos únicos y registrar el
/// modelo en `packages/database/src/soft-delete/config.ts`.

model Company {
  id   String  @id @default(cuid())
  name String
  slug String
  rnc  String?

  email String?
  phone String?

  isActive  Boolean   @default(true)
  deletedAt DateTime?

  branches     Branch[]
  users        UserCompany[]
  categories   Category[]
  products     Product[]
  employees    Employee[]
  suppliers    Supplier[]
  customers    Customer[]
  ncfSequences NcfSequence[]
  discounts    Discount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug, deletedAt])
}

model Branch {
  id String @id @default(cuid())

  companyId String
  name      String
  address   String?

  isActive  Boolean   @default(true)
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id])

  employees          Employee[]
  inventories        Inventory[]
  inventoryMovements InventoryMovement[]
  sales              Sale[]
  purchaseOrders     PurchaseOrder[]
  cashRegisters      CashRegister[]
  transfersFrom      Transfer[]          @relation("TransferFrom")
  transfersTo        Transfer[]          @relation("TransferTo")
  returns            Return[]
  auditLogs          AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([deletedAt])
}

model User {
  id String @id @default(cuid())

  email        String
  passwordHash String
  firstName    String
  lastName     String

  isActive  Boolean   @default(true)
  deletedAt DateTime?

  lastLoginAt DateTime?

  memberships   UserCompany[]
  employee      Employee?
  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, deletedAt])
}

model Role {
  id String @id @default(cuid())

  name        RoleName
  description String?

  deletedAt DateTime?

  users UserCompany[]

  @@unique([name, deletedAt])
}

model UserCompany {
  id String @id @default(cuid())

  userId          String
  companyId       String
  roleId          String
  defaultBranchId String?

  deletedAt DateTime?

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  role    Role    @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, deletedAt])
  @@index([companyId])
  @@index([deletedAt])
}

model RefreshToken {
  id String @id @default(cuid())

  userId            String
  hashedToken       String
  expiresAt         DateTime
  revoked           Boolean   @default(false)
  revokedAt         DateTime?
  createdByIp       String?
  revokedByIp       String?
  userAgent         String?
  replacedByTokenId String?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id String @id @default(cuid())

  companyId String?
  branchId  String?
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?

  branch Branch? @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([branchId])
  @@index([entity, entityId])
}

model Category {
  id String @id @default(cuid())

  companyId   String
  name        String
  description String?

  isActive  Boolean   @default(true)
  deletedAt DateTime?

  company   Company    @relation(fields: [companyId], references: [id])
  products  Product[]
  discounts Discount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name, deletedAt])
  @@index([companyId])
  @@index([deletedAt])
}

model Product {
  id String @id @default(cuid())

  companyId  String
  supplierId String?

  name        String
  code        String
  description String?
  imageUrl    String?
  price       Decimal @db.Decimal(10, 2)

  isActive  Boolean   @default(true)
  deletedAt DateTime?

  company    Company    @relation(fields: [companyId], references: [id])
  supplier   Supplier?  @relation(fields: [supplierId], references: [id])
  categories Category[]

  inventories        Inventory[]
  inventoryMovements InventoryMovement[]
  saleItems          SaleItem[]
  purchaseOrderItems PurchaseOrderItem[]
  returnItems        ReturnItem[]
  transferItems      TransferItem[]
  discounts          Discount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code, deletedAt])
  @@index([companyId])
  @@index([deletedAt])
}

/// Usuario operativo del ERP. Siempre vinculado a User + UserCompany.
model Employee {
  id String @id @default(cuid())

  companyId String
  branchId  String
  userId    String @unique

  phone           String?
  position        String?
  salary          Decimal?  @db.Decimal(10, 2)
  hireDate        DateTime?
  terminationDate DateTime?

  isActive  Boolean   @default(true)
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  sales                       Sale[]
  cashShifts                  CashShift[]
  returns                     Return[]
  inventoryMovementsPerformed InventoryMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([branchId])
  @@index([deletedAt])
}

model Supplier {
  id String @id @default(cuid())

  companyId String
  name      String

  contactName String?
  email       String?
  phone       String?
  rnc         String?
  address     String?
  notes       String?

  isActive  Boolean   @default(true)
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id])

  products        Product[]
  purchaseOrders  PurchaseOrder[]
  accountsPayable AccountPayable[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name, deletedAt])
  @@index([companyId])
  @@index([deletedAt])
}

model Customer {
  id String @id @default(cuid())

  companyId String

  firstName String
  lastName  String

  email   String?
  phone   String?
  address String?
  cedula  String?

  isActive  Boolean   @default(true)
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id])

  sales              Sale[]
  accountsReceivable AccountReceivable[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([deletedAt])
}

model Inventory {
  id String @id @default(cuid())

  branchId  String
  productId String
  quantity  Decimal @default(0) @db.Decimal(12, 3)

  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, productId])
  @@index([productId])
}

model InventoryMovement {
  id String @id @default(cuid())

  branchId  String
  productId String
  type      InventoryMovementType
  quantity  Decimal               @db.Decimal(12, 3)
  notes     String?

  saleId                String?
  purchaseOrderId       String?
  returnId              String?
  transferId            String?
  performedByEmployeeId String?

  branch      Branch    @relation(fields: [branchId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])
  performedBy Employee? @relation(fields: [performedByEmployeeId], references: [id])

  sale          Sale?          @relation(fields: [saleId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  return        Return?        @relation(fields: [returnId], references: [id])
  transfer      Transfer?      @relation(fields: [transferId], references: [id])

  createdAt DateTime @default(now())

  @@index([branchId, productId])
  @@index([performedByEmployeeId])
  @@index([type])
  @@index([createdAt])
}

model NcfSequence {
  id String @id @default(cuid())

  companyId      String
  type           NcfType
  prefix         String
  currentNumber  Int
  maxNumber      Int
  expirationDate DateTime

  isActive  Boolean   @default(true)
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id])
  sales   Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, type, prefix, deletedAt])
  @@index([companyId])
  @@index([deletedAt])
}

model Sale {
  id String @id @default(cuid())

  branchId      String
  customerId    String?
  cashierId     String
  cashShiftId   String?
  ncfSequenceId String?

  ncf       String?
  subtotal  Decimal    @db.Decimal(10, 2)
  taxAmount Decimal    @default(0) @db.Decimal(10, 2)
  total     Decimal    @db.Decimal(10, 2)
  status    SaleStatus @default(PENDING)

  branch      Branch       @relation(fields: [branchId], references: [id])
  customer    Customer?    @relation(fields: [customerId], references: [id])
  cashier     Employee     @relation(fields: [cashierId], references: [id])
  cashShift   CashShift?   @relation(fields: [cashShiftId], references: [id])
  ncfSequence NcfSequence? @relation(fields: [ncfSequenceId], references: [id])

  items              SaleItem[]
  payments           Payment[]
  inventoryMovements InventoryMovement[]
  accountReceivable  AccountReceivable?
  returns            Return[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([customerId])
  @@index([cashierId])
  @@index([status])
  @@index([createdAt])
}

model SaleItem {
  id String @id @default(cuid())

  saleId    String
  productId String

  quantity           Decimal  @db.Decimal(12, 3)
  unitPrice          Decimal  @db.Decimal(10, 2)
  discountPercentage Decimal? @db.Decimal(5, 2)
  discountAmount     Decimal? @db.Decimal(10, 2)
  subtotal           Decimal  @db.Decimal(10, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id String @id @default(cuid())

  saleId String
  method PaymentMethod
  amount Decimal       @db.Decimal(10, 2)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([saleId])
}

model PurchaseOrder {
  id String @id @default(cuid())

  branchId   String
  supplierId String

  status PurchaseOrderStatus @default(DRAFT)
  notes  String?

  subtotal  Decimal @default(0) @db.Decimal(10, 2)
  taxAmount Decimal @default(0) @db.Decimal(10, 2)
  total     Decimal @default(0) @db.Decimal(10, 2)

  branch   Branch   @relation(fields: [branchId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  items              PurchaseOrderItem[]
  inventoryMovements InventoryMovement[]
  accountPayable     AccountPayable?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderItem {
  id String @id @default(cuid())

  purchaseOrderId String
  productId       String

  quantity Decimal @db.Decimal(12, 3)
  unitCost Decimal @db.Decimal(10, 2)
  subtotal Decimal @db.Decimal(10, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
}

model CashRegister {
  id String @id @default(cuid())

  branchId String
  name     String

  isActive  Boolean   @default(true)
  deletedAt DateTime?

  branch Branch @relation(fields: [branchId], references: [id])

  shifts CashShift[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, name, deletedAt])
  @@index([branchId])
  @@index([deletedAt])
}

model CashShift {
  id String @id @default(cuid())

  cashRegisterId String
  cashierId      String

  openingAmount Decimal   @db.Decimal(10, 2)
  closingAmount Decimal?  @db.Decimal(10, 2)
  openedAt      DateTime  @default(now())
  closedAt      DateTime?

  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id])
  cashier      Employee     @relation(fields: [cashierId], references: [id])

  sales Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cashRegisterId])
  @@index([cashierId])
  @@index([openedAt])
}

model AccountReceivable {
  id String @id @default(cuid())

  customerId String
  saleId     String @unique

  originalAmount Decimal          @db.Decimal(10, 2)
  balance        Decimal          @db.Decimal(10, 2)
  dueDate        DateTime
  status         ReceivableStatus @default(OPEN)

  customer Customer @relation(fields: [customerId], references: [id])
  sale     Sale     @relation(fields: [saleId], references: [id])

  payments ReceivablePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([dueDate])
  @@index([status])
}

model ReceivablePayment {
  id String @id @default(cuid())

  accountReceivableId String
  amount              Decimal @db.Decimal(10, 2)
  notes               String?

  accountReceivable AccountReceivable @relation(fields: [accountReceivableId], references: [id])

  createdAt DateTime @default(now())

  @@index([accountReceivableId])
}

model AccountPayable {
  id String @id @default(cuid())

  supplierId      String
  purchaseOrderId String @unique

  originalAmount Decimal       @db.Decimal(10, 2)
  balance        Decimal       @db.Decimal(10, 2)
  dueDate        DateTime
  status         PayableStatus @default(OPEN)

  supplier      Supplier      @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  payments PayablePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([dueDate])
  @@index([status])
}

model PayablePayment {
  id String @id @default(cuid())

  accountPayableId String
  amount           Decimal @db.Decimal(10, 2)
  notes            String?

  accountPayable AccountPayable @relation(fields: [accountPayableId], references: [id])

  createdAt DateTime @default(now())

  @@index([accountPayableId])
}

/// Promoción por porcentaje. Many-to-many con Product y/o Category.
/// Un descuento puede vincularse a varios productos y/o categorías.
model Discount {
  id String @id @default(cuid())

  companyId String

  name        String
  description String?
  percentage  Decimal @db.Decimal(5, 2)

  startDate DateTime?
  endDate   DateTime?

  isActive  Boolean   @default(true)
  deletedAt DateTime?

  company    Company    @relation(fields: [companyId], references: [id])
  products   Product[]
  categories Category[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([deletedAt])
}

model Return {
  id String @id @default(cuid())

  branchId   String
  saleId     String?
  employeeId String

  reason ReturnReason
  notes  String?

  subtotal Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @default(0) @db.Decimal(10, 2)

  branch   Branch   @relation(fields: [branchId], references: [id])
  sale     Sale?    @relation(fields: [saleId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  items              ReturnItem[]
  inventoryMovements InventoryMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([saleId])
}

model ReturnItem {
  id String @id @default(cuid())

  returnId  String
  productId String

  quantity Decimal @db.Decimal(12, 3)
  subtotal Decimal @db.Decimal(10, 2)

  return  Return  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([returnId])
  @@index([productId])
}

model Transfer {
  id String @id @default(cuid())

  fromBranchId String
  toBranchId   String
  status       TransferStatus @default(PENDING)
  notes        String?

  fromBranch Branch @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranch   Branch @relation("TransferTo", fields: [toBranchId], references: [id])

  items              TransferItem[]
  inventoryMovements InventoryMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([status])
}

model TransferItem {
  id String @id @default(cuid())

  transferId String
  productId  String

  quantity Decimal @db.Decimal(12, 3)

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([transferId])
  @@index([productId])
}
