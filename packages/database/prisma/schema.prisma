// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  OWNER
  ADMIN
  MANAGER
  CASHIER
  INVENTORY_ASSISTANT
}

/// Master data con soft delete. Al agregar Product, Customer o Supplier, incluir
/// `deletedAt`, `@@unique([campo, deletedAt])` en campos únicos y registrar el
/// modelo en `packages/database/src/soft-delete/config.ts`.
model Company {
  id            String   @id @default(cuid())

  name          String
  slug          String

  rnc           String?

  email         String?
  phone         String?

  isActive      Boolean  @default(true)
  deletedAt     DateTime?

  branches      Branch[]
  users         UserCompany[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([slug, deletedAt])
}

model Branch {
  id            String   @id @default(cuid())

  companyId     String

  name          String
  address       String?

  isActive      Boolean  @default(true)
  deletedAt     DateTime?

  company       Company  @relation(fields: [companyId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId])
  @@index([deletedAt])
}

model User {
  id              String   @id @default(cuid())

  email           String
  passwordHash    String

  firstName       String
  lastName        String

  isActive        Boolean  @default(true)
  deletedAt       DateTime?

  lastLoginAt     DateTime?

  memberships     UserCompany[]

  refreshTokens   RefreshToken[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([email, deletedAt])
}

model Role {
  id            String   @id @default(cuid())

  name          RoleName
  description   String?

  deletedAt     DateTime?

  users         UserCompany[]

  @@unique([name, deletedAt])
}

model UserCompany {
  id              String   @id @default(cuid())

  userId          String
  companyId       String
  roleId          String

  defaultBranchId String?

  deletedAt       DateTime?

  user            User     @relation(fields: [userId], references: [id])
  company         Company  @relation(fields: [companyId], references: [id])
  role            Role     @relation(fields: [roleId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, deletedAt])
  @@index([companyId])
  @@index([deletedAt])
}

model RefreshToken {
  id                String   @id @default(cuid())

  userId            String

  hashedToken       String

  expiresAt         DateTime

  revoked           Boolean  @default(false)
  revokedAt         DateTime?

  createdByIp       String?
  revokedByIp       String?

  userAgent         String?

  replacedByTokenId String?

  user              User     @relation(fields: [userId], references: [id])

  createdAt         DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id              String   @id @default(cuid())

  companyId       String?
  userId          String?

  action          String

  entity          String?
  entityId        String?

  metadata        Json?

  createdAt       DateTime @default(now())
}
