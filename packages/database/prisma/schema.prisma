// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id            String   @id @default(cuid())

  name          String
  slug          String   

  rnc           String?

  email         String?
  phone         String?

  isActive      Boolean  @default(true)
  deletedAt     DateTime?
	
  branches      Branch[]
  users         UserCompany[]
  customers Customer[]
  products Product[]
  categories Category[]
  discounts Discount[]
  transfers Transfer[]
  suppliers Supplier[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([slug, deletedAt])
}

model Branch {
  id String @id @default(cuid())

  name String
  address String?
  phone String?

  isActive Boolean @default(true)
  deletedAt DateTime?

  companyId String
  company Company @relation(fields: [companyId], references: [id])

  employees Employee[]
  stocks Stock[]

  sales Sale[]
  purchaseOrders PurchaseOrder[]

  cashRegisters CashRegister[]
  ncfSequences NCFSequence[]

  sourceTransfers Transfer[] @relation("SourceTransfers")
  destinationTransfers Transfer[] @relation("DestinationTransfers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name, deletedAt])
  @@index([companyId])
  @@index([deletedAt])
}

model User {
  id              String   @id @default(cuid())

  email           String   @unique
  passwordHash    String

  firstName       String
  lastName        String

  isActive        Boolean  @default(true)
  deletedAt       DateTime?

  lastLoginAt     DateTime?

  memberships     UserCompany[]

  refreshTokens   RefreshToken[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([email, deletedAt])
}

model Role {
  id            String   @id @default(cuid())

  name          RoleName
  description   String?

  users         UserCompany[]
  
  deletedAt     DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, deletedAt])
}
enum RoleName {
  OWNER
  ADMIN
  MANAGER
  CASHIER
  INVENTORY_ASSISTANT
}
model UserCompany {
  id              String   @id @default(cuid())

  userId          String
  companyId       String
  roleId          String

  defaultBranchId String?

  user            User     @relation(fields: [userId], references: [id])
  company         Company  @relation(fields: [companyId], references: [id])
  role            Role     @relation(fields: [roleId], references: [id])
  
  deletedAt 	  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, deletedAt]) 
  @@index([userId])
  @@index([companyId])
}

model Customer {
  id                String          @id @default(cuid())

  customerCode      String

  firstName         String
  lastName          String

  email             String?
  phoneNumber       String?

  documentId        String? // cedula o RNC

  address           String?

  creditLimit       Float           @default(0)
  currentBalance    Float           @default(0)

  isActive          Boolean         @default(true)

  companyId         String
  company           Company         @relation(fields: [companyId], references: [id])

  sales             Sale[]
  payments          Payment[]
  returns           Return[]

  deletedAt         DateTime?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([companyId, customerCode, deletedAt])

  @@index([companyId])
  @@index([documentId])
  @@index([deletedAt])
}

model Category {
  id              String              @id @default(cuid())

  name            String
  description     String?

  state           Boolean             @default(true)

  companyId       String
  company         Company             @relation(fields: [companyId], references: [id])

  deletedAt       DateTime?

  products        CategoryProduct[]
  discounts      DiscountCategory[]

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([companyId])
  @@index([deletedAt])

  @@unique([companyId, name, deletedAt])
}

model Product {
  id                  String               @id @default(cuid())

  name                String
  description         String?

  code                String?

  brand               String?
  type                String?

  salePrice           Float

  state               Boolean              @default(true)

  companyId           String
  company             Company              @relation(fields: [companyId], references: [id])

  deletedAt           DateTime?

  categories          CategoryProduct[]
  discounts      DiscountProduct[]
  stocks         Stock[]
  purchaseDetails PurchaseOrderDetail[]
  saleDetails     SaleDetail[]
  returnDetails   ReturnDetail[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([companyId])
  @@index([deletedAt])
  @@unique([companyId, code, deletedAt])
}

model CategoryProduct {
  categoryId      String
  productId       String

  category        Category   @relation(fields: [categoryId], references: [id])
  product         Product    @relation(fields: [productId], references: [id])

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@id([categoryId, productId])
}

model Employee {
  id            String   @id @default(cuid())

  employeeId    String
  name          String
  position      String
  phoneNumber   String

  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id])

  deletedAt     DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  purchaseOrders PurchaseOrder[]
  sales          Sale[]
  cashShifts     CashShift[]
  returns        Return[]

  @@unique([branchId, employeeId, deletedAt])
  @@index([branchId])
  @@index([deletedAt])
}

model Supplier {
  id            String   @id @default(cuid())

  supplierId    String

  email         String
  rnc           String
  phoneNumber   String
  address       String
  name          String

  deletedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  
  purchaseOrders PurchaseOrder[]

  @@unique([companyId, supplierId, deletedAt])
  @@index([companyId])
  @@index([deletedAt])
}
model AuditLog {
  id              String   @id @default(cuid())

  companyId       String?
  userId          String?

  action          String

  entity          String?
  entityId        String?

  metadata        Json?

  createdAt       DateTime @default(now())
}
model RefreshToken {
  id                String   @id @default(cuid())

  userId            String

  hashedToken       String

  expiresAt         DateTime

  revoked           Boolean  @default(false)
  revokedAt         DateTime?

  createdByIp       String?
  revokedByIp       String?

  userAgent         String?

  replacedByTokenId String?

  user              User     @relation(fields: [userId], references: [id])

  createdAt         DateTime @default(now())

  @@index([userId])
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Discount {
  id                String                @id @default(cuid())

  name              String
  description       String?

  type              DiscountType

  value             Float

  startDate         DateTime
  endDate           DateTime

  isActive          Boolean               @default(true)

  companyId         String
  company           Company               @relation(fields: [companyId], references: [id])

  deletedAt         DateTime?

  products          DiscountProduct[]
  categories        DiscountCategory[]

  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([companyId])
  @@index([deletedAt])
  @@index([isActive])

  @@unique([companyId, name, startDate, endDate, deletedAt])
}

model DiscountProduct {
  discountId        String
  productId         String

  discount          Discount   @relation(fields: [discountId], references: [id])
  product           Product    @relation(fields: [productId], references: [id])

  createdAt         DateTime   @default(now())

  @@id([discountId, productId])

  @@index([discountId])
  @@index([productId])
}

model DiscountCategory {
  discountId        String
  categoryId        String

  discount          Discount   @relation(fields: [discountId], references: [id])
  category          Category   @relation(fields: [categoryId], references: [id])

  createdAt         DateTime   @default(now())

  @@id([discountId, categoryId])

  @@index([discountId])
  @@index([categoryId])
}


model Stock {
  id                    String      @id @default(cuid())

  branchId              String
  productId             String

  quantityAvailable     Int         @default(0)
  minimumQuantity       Int         @default(0)

  branch                Branch      @relation(fields: [branchId], references: [id])
  product               Product     @relation(fields: [productId], references: [id])

  deletedAt             DateTime?

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  
  inventoryWastes      InventoryWaste[]
  transferProducts     TransferProduct[]

  @@unique([branchId, productId, deletedAt])

  @@index([branchId])
  @@index([productId])
  @@index([deletedAt])
}

model InventoryWaste {
  id                String      @id @default(cuid())

  stockId           String

  quantity          Int
  reason            String?

  stock             Stock      @relation(fields: [stockId], references: [id])

  deletedAt         DateTime?

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([stockId])
  @@index([deletedAt])
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model Transfer {
  id                    String             @id @default(cuid())

  companyId             String
  company               Company           @relation(fields: [companyId], references: [id])

  sourceBranchId        String
  destinationBranchId   String

  sourceBranch          Branch            @relation("SourceTransfers", fields: [sourceBranchId], references: [id])

  destinationBranch     Branch            @relation("DestinationTransfers", fields: [destinationBranchId], references: [id])

  status                TransferStatus    @default(PENDING)

  notes                 String?

  products              TransferProduct[]

  deletedAt             DateTime?

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([companyId])
  @@index([sourceBranchId])
  @@index([destinationBranchId])
  @@index([deletedAt])
}

model TransferProduct {
  transferId         String
  stockId            String

  quantity           Int

  transfer           Transfer    @relation(fields: [transferId], references: [id])
  stock              Stock       @relation(fields: [stockId], references: [id])

  createdAt          DateTime    @default(now())

  @@id([transferId, stockId])

  @@index([transferId])
  @@index([stockId])
}

enum PurchaseOrderStatus {
  PENDING
  PARTIAL
  COMPLETED
  CANCELLED
}

model PurchaseOrder {
  id                    String                       @id @default(cuid())

  orderNumber           String

  supplierId            String
  supplier              Supplier                    @relation(fields: [supplierId], references: [id])

  branchId              String
  branch                Branch                     @relation(fields: [branchId], references: [id])

  employeeId            String?
  employee              Employee?                  @relation(fields: [employeeId], references: [id])

  status                PurchaseOrderStatus        @default(PENDING)

  subtotal              Float
  tax                   Float                      @default(0)
  total                 Float

  details               PurchaseOrderDetail[]

  deletedAt             DateTime?

  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  @@unique([branchId, orderNumber])

  @@index([supplierId])
  @@index([branchId])
  @@index([deletedAt])
}

model PurchaseOrderDetail {
  id                    String            @id @default(cuid())

  purchaseOrderId       String
  productId             String

  quantity              Int

  unitPrice             Float

  subtotal              Float

  purchaseOrder         PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id])
  product               Product           @relation(fields: [productId], references: [id])

  createdAt             DateTime          @default(now())

  @@index([purchaseOrderId])
  @@index([productId])
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

model Sale {
  id                  String            @id @default(cuid())
  ncf 			String @unique

  invoiceNumber       String

  customerId          String?
  customer            Customer?         @relation(fields: [customerId], references: [id])

  branchId            String
  branch              Branch            @relation(fields: [branchId], references: [id])

  employeeId          String?
  employee            Employee?         @relation(fields: [employeeId], references: [id])

  subtotal            Float
  tax                 Float             @default(0)
  total               Float

  status              SaleStatus        @default(COMPLETED)

  details             SaleDetail[]
  payments            Payment[]
  returns        Return[]
  creditNotes    CreditNote[]

  deletedAt           DateTime?

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([branchId, invoiceNumber])

  @@index([customerId])
  @@index([branchId])
  @@index([deletedAt])
}

model SaleDetail {
  id                    String          @id @default(cuid())

  saleId                String
  productId             String

  quantity              Int

  unitPrice             Float

  appliedDiscount       Float           @default(0)

  subtotal              Float

  sale                  Sale            @relation(fields: [saleId], references: [id])
  product               Product         @relation(fields: [productId], references: [id])

  createdAt             DateTime        @default(now())

  @@index([saleId])
  @@index([productId])
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CREDIT
  CHECK
  OTHER
}

model Payment {
  id                  String            @id @default(cuid())

  saleId              String
  sale                Sale              @relation(fields: [saleId], references: [id])

  customerId          String?
  customer            Customer?         @relation(fields: [customerId], references: [id])

  method              PaymentMethod

  amount              Float

  referenceNumber     String?

  notes               String?

  deletedAt           DateTime?

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([saleId])
  @@index([customerId])
  @@index([deletedAt])
}

enum CashRegisterStatus {
  ACTIVE
  INACTIVE
}

model CashRegister {
  id                  String                  @id @default(cuid())

  name                String
  description         String?

  branchId            String
  branch              Branch                 @relation(fields: [branchId], references: [id])

  status              CashRegisterStatus     @default(ACTIVE)

  shifts              CashShift[]

  deletedAt           DateTime?

  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@unique([branchId, name, deletedAt])
  @@index([branchId])
  @@index([deletedAt])
}

model CashShift {
  id                    String            @id @default(cuid())

  cashRegisterId        String
  cashRegister          CashRegister     @relation(fields: [cashRegisterId], references: [id])

  employeeId            String
  employee              Employee         @relation(fields: [employeeId], references: [id])

  openingAmount         Float

  closingAmount         Float?

  expectedAmount        Float?

  openedAt              DateTime         @default(now())
  closedAt              DateTime?

  notes                 String?

  deletedAt             DateTime?

  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([cashRegisterId])
  @@index([employeeId])
  @@index([openedAt])
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model Return {
  id                  String              @id @default(cuid())

  saleId              String
  sale                Sale                @relation(fields: [saleId], references: [id])

  customerId          String?
  customer            Customer?           @relation(fields: [customerId], references: [id])

  employeeId          String?
  employee            Employee?           @relation(fields: [employeeId], references: [id])

  reason              String?

  totalRefund         Float               @default(0)

  status              ReturnStatus        @default(PENDING)

  details             ReturnDetail[]

  creditNote          CreditNote?

  deletedAt           DateTime?

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([saleId])
  @@index([customerId])
  @@index([deletedAt])
}

model ReturnDetail {
  id                  String          @id @default(cuid())

  returnId            String
  productId           String

  quantity            Int

  unitPrice           Float

  subtotal            Float

  return              Return         @relation(fields: [returnId], references: [id])
  product             Product        @relation(fields: [productId], references: [id])

  createdAt           DateTime       @default(now())

  @@index([returnId])
  @@index([productId])
}

enum CreditNoteStatus {
  ACTIVE
  CANCELLED
}

model CreditNote {
  id                    String                @id @default(cuid())

  creditNoteNumber      String                @unique

  returnId              String                @unique
  return                Return               @relation(fields: [returnId], references: [id])

  saleId                String
  sale                  Sale                 @relation(fields: [saleId], references: [id])

  ncf                   String?

  reason                String?

  totalAmount           Float

  status                CreditNoteStatus     @default(ACTIVE)

  issuedAt              DateTime             @default(now())

  deletedAt             DateTime?

  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([saleId])
  @@index([deletedAt])
}

enum NCFType {
  CONSUMER_FINAL
  FISCAL_CREDIT
  SPECIAL
  CREDIT_NOTE
}

model NCFSequence {
  id                    String          @id @default(cuid())

  branchId              String
  branch                Branch         @relation(fields: [branchId], references: [id])

  type                  NCFType

  prefix                String

  currentNumber         Int             @default(0)

  maxNumber             Int

  expiresAt             DateTime?

  isActive              Boolean         @default(true)

  deletedAt             DateTime?

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@unique([branchId, type])

  @@index([branchId])
  @@index([deletedAt])
}