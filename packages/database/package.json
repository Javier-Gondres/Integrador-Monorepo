{
  "name": "@repo/db",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc",
    "lint": "eslint src --max-warnings 0",
    "check-types": "tsc --noEmit",
    "build:dev": "dotenv -e .env.development -- prisma generate && tsc",
    "db:generate": "prisma generate",
    "db:generate:dev": "dotenv -e .env.development -- prisma generate",
    "db:generate:staging": "dotenv -e .env.staging -- prisma generate",
    "db:generate:production": "dotenv -e .env.production -- prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:dev": "dotenv -e .env.development -- prisma migrate dev",
    "db:reset": "dotenv -e .env.development -- prisma migrate reset",
    "db:deploy": "prisma migrate deploy",
    "db:deploy:dev": "dotenv -e .env.development -- prisma migrate deploy",
    "db:deploy:staging": "dotenv -e .env.staging -- prisma migrate deploy",
    "db:deploy:production": "dotenv -e .env.production -- prisma migrate deploy",
    "db:seed:dev": "dotenv -e .env.development -- tsx prisma/seed.ts",
    "db:seed:staging": "dotenv -e .env.staging -- tsx prisma/seed.ts",
    "db:seed:production": "dotenv -e .env.production -- tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.0.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.39.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/pg": "^8.20.0",
    "pg": "^8.20.0",
    "prisma": "^7.8.0"
  }
}