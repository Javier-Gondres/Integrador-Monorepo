{
  "name": "@repo/db",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "dotenv -e .env.development -- prisma generate && tsc",
    "db:generate": "dotenv -e .env.development -- prisma generate",
    "db:migrate": "dotenv -e .env.development -- prisma migrate dev",
    "db:deploy": "dotenv -e .env.development -- prisma migrate deploy",
    "db:deploy:staging": "dotenv -e .env.staging -- prisma migrate deploy",
    "db:deploy:production": "dotenv -e .env.production -- prisma migrate deploy"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "dotenv-cli": "^8.0.0",
    "prisma": "^7.8.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/pg": "^8.20.0",
    "pg": "^8.20.0"
  }
}