# Copia a packages/database/.env.staging — pnpm db:deploy:staging
#
# Supabase (recomendado Prisma 7):
# - DATABASE_URL → Transaction pooler :6543 (runtime / adapter en apps).
# - DIRECT_URL → migraciones / Prisma CLI: Session pooler :5432 en el MISMO host pooler,
#   o Direct db.PROJECT_REF.supabase.co:5432. No uses :6543 para migrate (locks/transacciones).
# Si Direct (db.*) da P1001, prueba Session pooler en :5432 del host *.pooler.supabase.com.

DATABASE_URL="postgresql://postgres:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
