{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",

  "tasks": {
    "build": {
      "dependsOn": ["^build", "^db:generate"],

      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "DIRECT_URL",
        "NEXT_PUBLIC_*",
        "PORT"
      ],

      "inputs": ["$TURBO_DEFAULT$", ".env*"],

      "outputs": [".next/**", "dist/**", "!.next/cache/**"]
    },

    "dev": {
      "dependsOn": ["^build"],

      "env": [
        "NODE_ENV",
        "APP_ENV",
        "DATABASE_URL",
        "DIRECT_URL",
        "NEXT_PUBLIC_*"
      ],

      "inputs": ["$TURBO_DEFAULT$", ".env*"],

      "cache": false,
      "persistent": true
    },

    "dev:staging": {
      "dependsOn": ["^build"],
      "env": [
        "NODE_ENV",
        "APP_ENV",
        "DATABASE_URL",
        "DIRECT_URL",
        "NEXT_PUBLIC_*",
        "JWT_ACCESS_SECRET",
        "JWT_REFRESH_SECRET",
        "COOKIE_SAME_SITE",
        "COOKIE_SECURE"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "cache": false,
      "persistent": true
    },

    "db:generate": {
      "cache": false,
      "env": ["DATABASE_URL", "DIRECT_URL"]
    },

    "db:migrate": {
      "cache": false,
      "env": ["DATABASE_URL", "DIRECT_URL"]
    },

    "db:deploy": {
      "cache": false,
      "env": ["DATABASE_URL", "DIRECT_URL"]
    },

    "lint": {
      "dependsOn": ["^lint", "^build"],
      "env": ["DATABASE_URL", "DIRECT_URL"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", ".eslintrc*", "eslint.config.*"]
    },

    "check-types": {
      "dependsOn": ["^check-types", "^build"],
      "env": ["DATABASE_URL", "DIRECT_URL", "NEXT_PUBLIC_*"],
      "outputs": []
    }
  }
}
